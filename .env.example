PORT=3000
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_ID=your_telegram_user_id
# 可选：Forum 群组 ID（启用话题隔离功能）
# TELEGRAM_FORUM_CHAT_ID=your_forum_group_id
CHATWOOT_ACCESS_TOKEN=your_chatwoot_access_token
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=1
# 可选：Webhook 签名验证密钥（在 Chatwoot Webhook 设置中配置）
# CHATWOOT_WEBHOOK_SECRET=your_webhook_secret

# 可选：消息同步模式 —— webhook（默认，需在 Chatwoot 后台配 Webhook）| polling（轮询，无需 Webhook）| both
# 官方云 Webhook 不可用/收费时，改用 polling 即可（无需公网可达地址）
# CHATWOOT_SYNC_MODE=polling
# 可选（polling / both 生效）：轮询间隔秒数，默认 10
# POLL_INTERVAL_SECONDS=10
# 可选：每轮最多检查的会话数，默认 20（控制 API 请求量）
# POLL_MAX_CONVERSATIONS=20
# 可选：首次遇到某会话时是否转发历史消息，默认 false（只记断点，避免刷屏）
# POLL_FORWARD_HISTORY=false
# ── 关键词自动回复（KEYWORD_AUTO_REPLIES，可选；留空 = 不启用）──────
# 格式：单引号包裹的 YAML 列表；每条规则之间空一行；回复可分行书写，换行效果用行尾的 \n 控制
#   · 不写 inbox 的条目 = 默认规则，所有收件箱通用
#   · 需要差异化的条目：写 inbox: <收件箱ID>（可写数组，如 inbox: [3, 5]），只对该收件箱生效
#   · 按书写顺序匹配，第一条命中的生效（专属写在前面 = 专属优先）
#   · 关键词不区分大小写，用 | 分隔多个；兼容旧的单行 JSON 写法
KEYWORD_AUTO_REPLIES=

# 可选：关键词规则热加载 —— 修改本文件后无需重启容器，默认每 5 秒检测一次
#   · 需要 docker-compose 以目录方式挂载（compose 文件里已加 `- ./:/app/host:ro`）
#   · 仅关键词规则支持热加载；其余变量（Token / 端口 / 同步模式等）仍需重启生效
#   · 也可手动触发重载：docker compose kill -s HUP bot
ENV_FILE_PATH=/app/host/.env
# ENV_RELOAD_INTERVAL_SECONDS=5      # 设为 0 关闭热加载

# 可选：SQLite 数据库路径（默认 mappings.db）
# DB_PATH=mappings.db
# 日志级别：debug | info | warn | error
# LOG_LEVEL=info
# 可选：启用日志文件输出（同时写入 stdout 和文件）
# LOG_TO_FILE=true
# 可选：日志文件目录（默认 ./logs）
# LOG_DIR=./logs
# 可选：单个日志文件最大大小（MB，默认 10）
# LOG_MAX_SIZE_MB=10
# 可选：保留的轮转日志文件数量（默认 3）
# LOG_MAX_FILES=3
